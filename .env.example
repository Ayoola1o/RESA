# Google Gemini API Key for Genkit AI features (property recommendation, replies, descriptions)
# Obtain a key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Google Maps Platform JavaScript API Key for interactive property maps
# 1. Enable "Maps JavaScript API" in Google Cloud Console: https://console.cloud.google.com/google/maps-apis
# 2. Restrict key to "HTTP referrers (websites)":
#    - http://localhost:9002/*
#    - https://*.vercel.app/*
#    - your-production-domain.com/*
# 3. Restrict API to "Maps JavaScript API" only (Places, Geocoding, and Routes are not required)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Supabase project configuration (Project Settings → API)
# Use the publishable key in new projects. The legacy anon key is also accepted.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here

# Required for server-side Supabase Storage uploads and trusted admin/import operations.
# Never expose this secret with a NEXT_PUBLIC_ prefix or in browser code.
SUPABASE_SECRET_KEY=your_supabase_secret_key_here

# Needed to apply migrations with the Supabase CLI. Keep this private.
SUPABASE_DB_URL=postgresql://postgres:your-database-password@db.your-project-ref.supabase.co:5432/postgres
